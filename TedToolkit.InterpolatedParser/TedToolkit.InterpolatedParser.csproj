<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="CodeAnalysis.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="AlmostAllFrameworks.props" Sdk="TedToolkit.Build.Sdk"/>
  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworks);net11.0</TargetFrameworks>
  </PropertyGroup>
  
  <PropertyGroup>
    <Title>Interpolated Parser</Title>
    <Description>Interpolated Parser</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard' Or '$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe"/>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Localizations\Localization*.json"/>
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="TedToolkit.Localizations" />
  </ItemGroup>


  <ItemGroup>
    <None Include="../.agents/skills/parse-with-interpolated-patterns/**/*"
          Pack="true" PackagePath="skills/parse-with-interpolated-patterns/" />
  </ItemGroup>
</Project>
